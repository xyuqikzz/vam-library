# =========================================================================
# VAM Library - Git Ignore Configuration
# Supports Tauri 2.x (Rust) + Vue 3 (Vite/TypeScript) + SQLite
# =========================================================================

# -------------------------------------------------------------------------
# Node.js & Vite Frontend
# -------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# Cache and build outputs
.npm
.eslintcache
.stylelintcache
.prettiercache
package-lock.json.log
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
npm-debug.log*

# -------------------------------------------------------------------------
# Rust & Tauri Backend
# -------------------------------------------------------------------------
# Rust compilation target directory
src-tauri/target/

# Tauri auto-generated capabilities schema files
src-tauri/gen/schemas/

# Backup files generated by cargo/rustfmt
**/*.rs.bk

# -------------------------------------------------------------------------
# Environment & Secret Files
# -------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# -------------------------------------------------------------------------
# Database & Caching (SQLite)
# -------------------------------------------------------------------------
# SQLite databases used for local scanning index / cache
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# -------------------------------------------------------------------------
# System & OS Files
# -------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -------------------------------------------------------------------------
# IDEs & Code Editors
# -------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/settings.json

# JetBrains (WebStorm, RustRover, CLion, etc.)
.idea/

# Other Editors / Temporary files
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.bak
*.tmp
*.temp

# -------------------------------------------------------------------------
# Logs
# -------------------------------------------------------------------------
logs/
*.log

# -------------------------------------------------------------------------
# Project Custom Ignores (Retained)
# -------------------------------------------------------------------------
AGENTS.md
.omo
